def comp_mm1_vs_mm2(ses):
    """Devuelve indicadores M/M/1 base recalculados y M/M/2 para comparar."""
    lam = ses['lambda']
    mu  = ses['mu']
    b   = mm1(lam, mu)   # base M/M/1 (teórico puro)
    m2  = mm2(lam, mu)
    return b, m2

