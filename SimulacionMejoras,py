# ─── CELDA 12 ── Helper para armar series comparativas ───────────────────────

def series_escenarios(ses):
    """
    Devuelve listas paralelas (etiquetas, Wq, W, rho, Lq) para graficar
    todos los escenarios de forma unificada.
    """
    res = resultados[ses['nombre']]
    etiq, wq_l, w_l, rho_l, lq_l = [], [], [], [], []

    def agrega(label, df_row):
        etiq.append(label)
        for lst, col in [(wq_l,'Wq'),(w_l,'W'),(rho_l,'rho'),(lq_l,'Lq')]:
            v = df_row[col] if isinstance(df_row[col], (float,int)) else np.nan
            lst.append(v)

    # Base
    etiq.append('Base')
    wq_l.append(ses['Wq_base']); w_l.append(ses['W_base'])
    rho_l.append(ses['rho_base']); lq_l.append(np.nan)

    for i, r in enumerate(['-5%','-10%','-15%','-20%']):
        agrega(f'Serv. {r}', res['esc1'].iloc[i])

    for i, t in enumerate(['3.0','2.5','2.0']):
        agrega(f'Tope {t}', res['esc2'].iloc[i])

    for i, r in enumerate(['-5%','-10%','-15%']):
        agrega(f'λ {r}', res['esc3'].iloc[i])

    agrega('M/M/2', res['esc4'].iloc[0])
    agrega('Combinado', res['esc5'].iloc[0])

    return etiq, np.array(wq_l), np.array(w_l), np.array(rho_l), np.array(lq_l)

# Colores por grupo
def colores_barra(etiq):
    mapa = {
        'Base'    : '#455A64',
        'Serv.'   : '#2196F3',
        'Tope'    : '#009688',
        'λ '      : '#FF9800',
        'M/M/2'   : '#9C27B0',
        'Combinado': '#F44336',
    }
    cols = []
    for e in etiq:
        asignado = '#607D8B'
        for k, c in mapa.items():
            if e.startswith(k):
                asignado = c; break
        cols.append(asignado)
    return cols

def leyenda_parches():
