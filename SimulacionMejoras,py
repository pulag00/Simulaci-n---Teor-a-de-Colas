# ─── CELDA 3 ── Funciones analíticas de colas ────────────────────────────────

def mm1(lam, mu):
    """
    Calcula todos los indicadores M/M/1.
    Devuelve dict con los indicadores o marca 'inestable' si rho >= 1.
    """
    if lam >= mu:
        return {k: "inestable" for k in
                ['rho','P0','Lq','L','Wq','W']}
    rho = lam / mu
    P0  = 1 - rho
    Lq  = lam**2 / (mu * (mu - lam))
    L   = lam / (mu - lam)
    Wq  = lam / (mu * (mu - lam))
    W   = 1 / (mu - lam)
    return dict(rho=rho, P0=P0, Lq=Lq, L=L, Wq=Wq, W=W)


def mm2(lam, mu):
    """
    Calcula todos los indicadores M/M/2 (s = 2 servidores).
    Devuelve dict con los indicadores o marca 'inestable' si lam >= 2*mu.
    """
    s = 2
    if lam >= s * mu:
        return {k: "inestable" for k in
                ['rho','P0','Pw','Lq','L','Wq','W']}
    rho = lam / (s * mu)
    a   = lam / mu  # intensidad de tráfico

    # P0: inverso de [suma(a^n/n!, n=0..s-1) + (a^s/s!) * 1/(1-rho)]
    suma = sum(a**n / factorial(n) for n in range(s))
    P0   = 1 / (suma + (a**s / factorial(s)) * (1 / (1 - rho)))

    # Probabilidad de esperar (Erlang C)
    Pw = ((a**s / factorial(s)) * (1 / (1 - rho))) * P0

    # Longitud de cola
    Lq = ((a**s * rho) / (factorial(s) * (1 - rho)**2)) * P0

    Wq = Lq / lam
    W  = Wq + 1 / mu
    L  = lam * W

    return dict(rho=rho, P0=P0, Pw=Pw, Lq=Lq, L=L, Wq=Wq, W=W)


def delta_pct(nuevo, base):
    """Variación porcentual respecto al valor base."""
    if isinstance(nuevo, str) or base == 0:
        return "—"
    return round((nuevo - base) / base * 100, 2)

# ─── CELDA 4 ── Escenario 1: reducción del tiempo de servicio ────────────────
# Supuesto: señalización o recomendaciones logran que los usuarios reduzcan
# su tiempo de uso. Se modelan reducciones del 5 al 20 % sobre el mu base.

def escenario_reduccion_servicio(ses):
    lam      = ses['lambda']
    S_base   = ses['S_prom']
    Wq_base  = ses['Wq_base']
    reducciones = [0.05, 0.10, 0.15, 0.20]
    filas = []
    for r in reducciones:
        S_nuevo  = S_base * (1 - r)
        mu_nuevo = 1 / S_nuevo
        ind = mm1(lam, mu_nuevo)
        filas.append({
            'Reducción servicio': f"−{int(r*100)}%",
            'S_prom (min)'      : round(S_nuevo, 4),
            'mu (1/min)'        : round(mu_nuevo, 4),
            **{k: (round(v, 4) if isinstance(v, float) else v)
               for k, v in ind.items()},
            'ΔWq (%)'           : delta_pct(ind['Wq'], Wq_base),
        })
    return pd.DataFrame(filas).set_index('Reducción servicio')


# ─── CELDA 5 ── Escenario 2: control de servicios largos ─────────────────────
# Supuesto: un tope máximo de tiempo de uso durante horas pico reduce el
# tiempo promedio observado. Si el tope supera el promedio actual, no hay cambio.

def escenario_tope_servicio(ses):
    lam     = ses['lambda']
    S_base  = ses['S_prom']
    Wq_base = ses['Wq_base']
    topes   = [3.0, 2.5, 2.0]
    filas = []
    for tope in topes:
        S_nuevo  = min(S_base, tope)   # si tope > promedio, no cambia nada
        mu_nuevo = 1 / S_nuevo
        ind = mm1(lam, mu_nuevo)
        filas.append({
            'Tope máximo (min)': f"{tope} min",
            'S_prom (min)'     : round(S_nuevo, 4),
            'mu (1/min)'       : round(mu_nuevo, 4),
            **{k: (round(v, 4) if isinstance(v, float) else v)
               for k, v in ind.items()},
            'ΔWq (%)'          : delta_pct(ind['Wq'], Wq_base),
        })
    return pd.DataFrame(filas).set_index('Tope máximo (min)')


# ─── CELDA 6 ── Escenario 3: llegadas más distribuidas ───────────────────────
# Supuesto: informar a la comunidad sobre horarios de alta demanda desplaza
# parte de los usuarios a otros momentos, reduciendo la tasa de llegada λ.

def escenario_llegadas(ses):
    lam_base = ses['lambda']
    mu       = ses['mu']
    Wq_base  = ses['Wq_base']
    reducciones = [0.05, 0.10, 0.15]
    filas = []
    for r in reducciones:
        lam_nuevo = lam_base * (1 - r)
        ind = mm1(lam_nuevo, mu)
        filas.append({
            'Reducción λ'  : f"−{int(r*100)}%",
            'λ (1/min)'    : round(lam_nuevo, 4),
            **{k: (round(v, 4) if isinstance(v, float) else v)
               for k, v in ind.items()},
            'ΔWq (%)'      : delta_pct(ind['Wq'], Wq_base),
        })
    return pd.DataFrame(filas).set_index('Reducción λ')


# ─── CELDA 7 ── Escenario 4: dos microondas (M/M/2) ─────────────────────────
# Supuesto: se habilita un segundo microondas durante las horas pico. Los
# usuarios forman una sola cola y son atendidos por el primero disponible.

def escenario_mm2(ses):
    lam     = ses['lambda']
    mu      = ses['mu']
    Wq_base = ses['Wq_base']
    W_base  = ses['W_base']
    ind = mm2(lam, mu)
    fila = {
        'Sistema'  : 'M/M/2 (2 microondas)',
        'λ (1/min)': lam,
        'μ (1/min)': mu,
        **{k: (round(v, 4) if isinstance(v, float) else v)
           for k, v in ind.items()},
        'ΔWq (%)': delta_pct(ind.get('Wq'), Wq_base),
        'ΔW (%)'  : delta_pct(ind.get('W'),  W_base),
    }
    return pd.DataFrame([fila]).set_index('Sistema')


# ─── CELDA 8 ── Escenario 5: escenario combinado ─────────────────────────────
# Supuesto: señalización + comunicación logran simultáneamente reducir el
# tiempo de servicio y desplazar llegadas, ambos en un 10%.

def escenario_combinado(ses):
    lam_nuevo = ses['lambda'] * 0.90
    S_nuevo   = ses['S_prom'] * 0.90
    mu_nuevo  = 1 / S_nuevo
    Wq_base   = ses['Wq_base']
    W_base    = ses['W_base']
    ind = mm1(lam_nuevo, mu_nuevo)
    fila = {
        'Escenario'     : 'Combinado (−10% S + −10% λ)',
        'λ nuevo'       : round(lam_nuevo, 4),
        'μ nuevo'       : round(mu_nuevo, 4),
        'S_prom nuevo'  : round(S_nuevo, 4),
        **{k: (round(v, 4) if isinstance(v, float) else v)
           for k, v in ind.items()},
        'ΔWq (%)'  : delta_pct(ind.get('Wq'), Wq_base),
        'ΔW (%)'   : delta_pct(ind.get('W'),  W_base),
    }
    return pd.DataFrame([fila]).set_index('Escenario')


